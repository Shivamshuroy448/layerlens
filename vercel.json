{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "layerlens",
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": "api",
      "entrypoint": "index.py"
    }
  }
}
